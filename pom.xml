<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================
     CodeRunner — Frontend Module — Maven Build File
     Person 1 | DevOps Mini Project
    ============================================================

    Commands:
      mvn clean compile          → Compile source
      mvn test                   → Run unit tests only
      mvn verify                 → Run unit + integration tests
      mvn package                → Build JAR
      mvn clean package -DskipTests → Build JAR without running tests

    Profiles:
      mvn verify -P integration-tests  → Run only integration tests
    ============================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ── Project Identity ── -->
    <groupId>com.coderunner</groupId>
    <artifactId>frontend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>CodeRunner Frontend</name>
    <description>Frontend module for the CodeRunner online compiler — Person 1</description>

    <!-- ── Java Version ── -->
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions (centralised here for easy updates) -->
        <junit.version>5.10.0</junit.version>
        <surefire.version>3.1.2</surefire.version>
        <failsafe.version>3.1.2</failsafe.version>
    </properties>

    <!-- ── Dependencies ── -->
    <dependencies>

        <!-- JUnit 5 — Unit & Integration Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Params — for @ParameterizedTest -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Platform Launcher (needed by Surefire 3.x) -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.10.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ── Build Plugins ── -->
    <build>
        <!-- Point Maven to src/main/java and src/test/java -->
        <sourceDirectory>src/main/java</sourceDirectory>
        <testSourceDirectory>src/test/java</testSourceDirectory>

        <plugins>

            <!-- ── Compiler Plugin ── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
                ── Surefire Plugin — runs UNIT tests (`mvn test`) ──
                Excludes any class ending in IT.java or ITTest.java
                so integration tests don't run here.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!-- JUnit 5 engine -->
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <!-- Exclude integration tests from mvn test -->
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                    <!-- Reports go here — Jenkins reads this -->
                    <reportsDirectory>${project.build.directory}/surefire-reports</reportsDirectory>
                </configuration>
            </plugin>

            <!--
                ── Failsafe Plugin — runs INTEGRATION tests (`mvn verify`) ──
                Picks up classes ending in IT.java.
                Only runs when 'mvn verify' or 'mvn verify -P integration-tests' is called.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${failsafe.version}</version>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                    <reportsDirectory>${project.build.directory}/failsafe-reports</reportsDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ── JAR Plugin — creates executable JAR ── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <finalName>coderunner-frontend-${project.version}</finalName>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!-- ── Profiles ── -->
    <profiles>

        <!--
            Profile: integration-tests
            Run with: mvn verify -P integration-tests
            Jenkins uses this in the Integration Test stage.
            Requires the API server to be running at localhost:8080.
        -->
        <profile>
            <id>integration-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${failsafe.version}</version>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                                <include>**/*IntegrationTest.java</include>
                                <!-- Also include our main test file when this profile is active -->
                                <include>**/FrontendTest.java</include>
                            </includes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
